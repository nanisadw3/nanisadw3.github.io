---
import type { Lang } from "../i18n/ui.ts";
import { localizePath, otherLang, t } from "../i18n/utils.ts";

interface Props {
  lang: Lang;
  altHref: string | null;
}

const { lang, altHref } = Astro.props;
const path = Astro.url.pathname;

const links = (["projects", "github", "blog", "terminal"] as const).map((page) => ({
  href: localizePath(lang, page),
  label: t(lang, `nav.${page}`),
}));
const isActive = (href: string) => path.startsWith(href);
const switchHref = altHref ?? localizePath(otherLang(lang), "home");
---

<header class="sticky top-0 z-30 border-b border-line bg-bg-dark/85 backdrop-blur-md">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-5 font-mono text-[13px] sm:px-7" aria-label="Principal">
    <a href={localizePath(lang, "home")} class="font-bold text-fg transition-colors hover:text-blue">iñaki sobera</a>

    <ul class="flex items-center gap-1 sm:gap-5">
      {links.map((l) => (
        <li class="hidden sm:block">
          <a
            href={l.href}
            aria-current={isActive(l.href) ? "page" : undefined}
            class:list={["transition-colors", isActive(l.href) ? "text-fg" : "text-dim hover:text-fg"]}
          >
            {l.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href={switchHref}
          hreflang={otherLang(lang)}
          lang={otherLang(lang)}
          title={t(lang, "nav.switch")}
          class="rounded-md border border-line px-2 py-0.5 text-fg-2 transition-colors hover:border-blue hover:text-fg"
        >
          {otherLang(lang).toUpperCase()}
        </a>
      </li>
    </ul>
  </nav>
</header>
