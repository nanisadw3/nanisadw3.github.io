---
interface Props {
  id?: string;
  title: string;
  /** Optional "see all" link shown next to the title. */
  href?: string;
  hrefLabel?: string;
}

const { id, title, href, hrefLabel } = Astro.props;
---

<section id={id} class="mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-20">
  <div class="mb-8 flex items-baseline justify-between gap-4 border-b border-line pb-3">
    <h2 class="font-mono text-xs uppercase tracking-[0.15em] text-faint">{title}</h2>
    {href && (
      <a href={href} class="group text-sm text-muted transition-colors hover:text-fg">
        {hrefLabel}
        <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    )}
  </div>
  <slot />
</section>
