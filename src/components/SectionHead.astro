---
interface Props {
  n?: string;
  title: string;
  href?: string;
  hrefLabel?: string;
  as?: "h1" | "h2";
}

const { n, title, href, hrefLabel, as: Tag = "h2" } = Astro.props;
---

<div class="mb-6 flex items-baseline justify-between gap-4">
  <Tag class:list={["font-mono font-bold tracking-tight text-fg", Tag === "h1" ? "text-3xl sm:text-4xl" : "text-xl sm:text-[22px]"]}>
    {n && <span class="mr-2.5 text-sm font-medium text-blue">{n}</span>}{title}
  </Tag>
  {href && (
    <a href={href} class="shrink-0 font-mono text-[12.5px] text-blue hover:underline">{hrefLabel} →</a>
  )}
</div>
