---
import type { Experience } from "../data/profile.ts";

interface Props {
  item: Experience;
}

const { item } = Astro.props;
---

<article class="grid gap-4 sm:grid-cols-[200px_1fr] sm:gap-8">
  <div>
    <p class="font-mono text-xs text-faint">{item.period}</p>
    <p class="mt-1 font-semibold text-accent">{item.company}</p>
  </div>
  <div>
    <h3 class="text-lg font-semibold tracking-tight">{item.role}</h3>
    <p class="mt-1 text-sm text-muted">{item.summary}</p>
    <ul class="mt-5 space-y-4">
      {item.highlights.map((h) => (
        <li class="border-l border-line pl-4">
          <p class="text-sm font-medium text-fg">{h.title}</p>
          <p class="mt-1 text-sm leading-relaxed text-muted">{h.text}</p>
        </li>
      ))}
    </ul>
    <p class="mt-5 font-mono text-[11px] text-faint">{item.tags.join(" · ")}</p>
  </div>
</article>
