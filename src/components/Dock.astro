---
// "Dynamic island" navigation: a frosted-glass capsule with the brand mark and every section always
// visible. A glowing pill sits under the current section, follows the pointer, and slides from the
// previous section to the new one after a navigation. Keys 1–5 jump between sections.
import type { Lang } from "../i18n/ui.ts";
import { localizePath, otherLang, t } from "../i18n/utils.ts";

interface Props {
  lang: Lang;
  /** Same page in the other language, or null to fall back to its home page. */
  altHref: string | null;
}

const { lang, altHref } = Astro.props;
const other = otherLang(lang);
const switchHref = altHref ?? localizePath(other, "home");
const path = Astro.url.pathname.replace(/\/?$/, "/");

// Lucide icons (ISC license), stroke-based so they inherit currentColor.
const icons = {
  home: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  projects: '<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>',
  blog: '<path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/>',
  terminal: '<polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/>',
  // Itzamná's stepped fret (xicalcoliuhqui), the project's logo.
  itzamna: '<path d="M6.4 17.6V6.4h11.2v7.5h-7.5v-3.8h3.8"/>',
  globe: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
};

const items = (["home", "projects", "itzamna", "blog", "terminal"] as const).map((page, i) => {
  const href = localizePath(lang, page);
  const active = page === "home" ? path === href : path.startsWith(href);
  return { page, href, active, key: String(i + 1), label: t(lang, `nav.${page}`) };
});
---

<nav
  aria-label={lang === "es" ? "Secciones" : "Sections"}
  class="fixed bottom-3 left-1/2 z-40 -translate-x-1/2 sm:bottom-4"
  transition:name="dock"
  transition:animate="none"
>
  <div class="island">
    <a href={items[0].href} class="brand" tabindex="-1" aria-hidden="true">
      <img src="/favicon.svg" alt="" width="42" height="42" />
    </a>

    <ul class="track flex items-center" data-track>
      <span class="pill" aria-hidden="true"></span>
      {items.map((i) => (
        <li>
          <a
            href={i.href}
            aria-current={i.active ? "page" : undefined}
            aria-keyshortcuts={i.key}
            title={`${i.label} (${i.key})`}
            data-dock-key={i.key}
            class:list={["it", i.active && "on"]}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i.page]} />
            <span>{i.label}</span>
          </a>
        </li>
      ))}
      <li>
        <a href={switchHref} hreflang={other} lang={other} title={t(lang, "nav.switch")} class="it lang">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.globe} />
          <span>{other.toUpperCase()}</span>
        </a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .island {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px;
    border-radius: 999px;
    background: rgb(17 18 27 / 0.55);
    -webkit-backdrop-filter: blur(18px) saturate(170%);
    backdrop-filter: blur(18px) saturate(170%);
    border: 1px solid rgb(255 255 255 / 0.1);
    box-shadow:
      0 20px 45px -15px rgb(0 0 0 / 0.85),
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      inset 0 -1px 0 rgb(0 0 0 / 0.3);
    font-family: var(--font-mono);
  }
  .brand {
    display: grid;
    place-items: center;
    flex: none;
    margin-right: 4px;
    border-radius: 999px;
    transition: transform 0.3s;
  }
  .brand img {
    width: 42px;
    height: 42px;
    border-radius: 999px;
  }
  .island:hover .brand {
    transform: rotate(-12deg) scale(1.05);
  }

  .track {
    position: relative;
  }
  /* the sliding highlight; positioned by the script, hidden until it knows where to go */
  .pill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0;
    border-radius: 999px;
    opacity: 0;
    pointer-events: none;
    background: linear-gradient(135deg, rgb(187 154 247 / 0.42), rgb(122 162 247 / 0.42));
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.14),
      0 0 22px -4px rgb(122 162 247 / 0.65);
    transition:
      transform 0.5s cubic-bezier(0.3, 1.3, 0.4, 1),
      width 0.5s cubic-bezier(0.3, 1.3, 0.4, 1),
      opacity 0.25s;
  }
  .pill.ready {
    opacity: 1;
  }
  .pill.instant {
    transition: none;
  }

  .it {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    color: var(--color-fg-2);
    font-size: 14px;
    white-space: nowrap;
    transition: color 0.25s;
  }
  .it svg {
    width: 19px;
    height: 19px;
    flex: none;
  }
  .it:hover,
  .it.on,
  .it.lit {
    color: #fff;
  }
  .it.on {
    font-weight: 700;
  }
  /* without the script, the current section keeps a static highlight */
  .track:not(.live) .it.on {
    background: linear-gradient(135deg, rgb(187 154 247 / 0.42), rgb(122 162 247 / 0.42));
  }
  .it.lang {
    color: var(--color-cyan);
  }

  /* phones: icon over a label so all six items fit a 360 px screen */
  @media (max-width: 639px) {
    .island {
      gap: 0;
      padding: 5px;
    }
    .brand {
      display: none;
    }
    .it {
      flex-direction: column;
      justify-content: center;
      gap: 3px;
      height: 54px;
      min-width: 50px;
      padding: 0 6px;
      font-size: 10.5px;
    }
    .it svg {
      width: 20px;
      height: 20px;
    }
    .pill {
      border-radius: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .it,
    .brand,
    .pill {
      transition: none;
    }
  }
</style>

<script>
  // Sliding pill: where it sat before a navigation is kept in sessionStorage so the new page can
  // start it there and slide it to the new section.
  const KEY = "dock-pill";
  let onResize: (() => void) | null = null;
  const place = (pill: HTMLElement, el: HTMLElement | null) => {
    if (!el) {
      pill.classList.remove("ready");
      return;
    }
    pill.style.transform = `translateX(${el.offsetLeft}px)`;
    pill.style.width = `${el.offsetWidth}px`;
    pill.classList.add("ready");
  };

  const init = () => {
    const track = document.querySelector<HTMLElement>("[data-track]");
    if (!track || track.dataset.ready) return;
    track.dataset.ready = "1";
    track.classList.add("live");
    const pill = track.querySelector<HTMLElement>(".pill")!;
    const links = [...track.querySelectorAll<HTMLAnchorElement>("a.it")];
    const current = track.querySelector<HTMLElement>("a.it.on");

    let from: { x: number; w: number } | null = null;
    try {
      from = JSON.parse(sessionStorage.getItem(KEY) || "null");
      sessionStorage.removeItem(KEY);
    } catch {}

    if (from && current) {
      pill.classList.add("instant", "ready");
      pill.style.transform = `translateX(${from.x}px)`;
      pill.style.width = `${from.w}px`;
      pill.getBoundingClientRect();
      pill.classList.remove("instant");
      requestAnimationFrame(() => place(pill, current));
    } else {
      pill.classList.add("instant");
      place(pill, current);
      pill.getBoundingClientRect();
      pill.classList.remove("instant");
    }

    const light = (el: HTMLElement | null) => links.forEach((a) => a.classList.toggle("lit", a === el));
    for (const a of links) {
      a.addEventListener("pointerenter", (e) => {
        if (e.pointerType !== "mouse") return;
        place(pill, a);
        light(a);
      });
      a.addEventListener("focus", () => {
        place(pill, a);
        light(a);
      });
      a.addEventListener("click", () => {
        place(pill, a);
        try {
          sessionStorage.setItem(KEY, JSON.stringify({ x: a.offsetLeft, w: a.offsetWidth }));
        } catch {}
      });
    }
    const back = () => {
      place(pill, current);
      light(null);
    };
    track.addEventListener("pointerleave", back);
    track.addEventListener("focusout", (e) => {
      if (!track.contains(e.relatedTarget as Node)) back();
    });
    if (onResize) removeEventListener("resize", onResize);
    onResize = () => place(pill, current);
    addEventListener("resize", onResize);
  };

  // This module can load after Astro fired astro:page-load for the first page, so run now too.
  init();
  document.addEventListener("astro:page-load", init);

  // Keys 1–5 jump to the sections (ignored while typing or with modifiers).
  document.addEventListener("keydown", (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey || e.repeat) return;
    if ((e.target as HTMLElement).closest("input, textarea, select, [contenteditable='true']")) return;
    const link = document.querySelector<HTMLAnchorElement>(`[data-dock-key="${e.key}"]`);
    if (link) {
      e.preventDefault();
      link.click();
    }
  });
</script>
