---
// "Dynamic island" navigation: at rest a small capsule with the brand mark and the current
// section; it expands to every section on hover, keyboard focus, or a tap on touch screens.
// Keys 1–4 jump between sections. Solid background (no backdrop blur) for smooth scrolling.
import type { Lang } from "../i18n/ui.ts";
import { localizePath, otherLang, t } from "../i18n/utils.ts";

interface Props {
  lang: Lang;
  /** Same page in the other language, or null to fall back to its home page. */
  altHref: string | null;
}

const { lang, altHref } = Astro.props;
const other = otherLang(lang);
const switchHref = altHref ?? localizePath(other, "home");
const path = Astro.url.pathname.replace(/\/?$/, "/");

// Lucide icons (ISC license), stroke-based so they inherit currentColor.
const icons = {
  home: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  projects: '<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>',
  blog: '<path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/>',
  terminal: '<polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/>',
  globe: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
};

const items = (["home", "projects", "blog", "terminal"] as const).map((page, i) => {
  const href = localizePath(lang, page);
  const active = page === "home" ? path === href : path.startsWith(href);
  return { page, href, active, key: String(i + 1), label: t(lang, `nav.${page}`) };
});
const hasActive = items.some((i) => i.active);
---

<nav
  aria-label={lang === "es" ? "Secciones" : "Sections"}
  class="fixed bottom-3 left-1/2 z-40 -translate-x-1/2 sm:bottom-4"
  transition:name="dock"
  transition:animate="none"
>
  <div class:list={["island", !hasActive && "no-active"]} data-island>
    <button type="button" class="brand" data-island-toggle aria-expanded="false" aria-label={lang === "es" ? "Mostrar secciones" : "Show sections"}>
      <img src="/favicon.svg" alt="" width="34" height="34" />
    </button>

    <ul class="flex items-center">
      {items.map((i) => (
        <li>
          <a
            href={i.href}
            aria-current={i.active ? "page" : undefined}
            aria-keyshortcuts={i.key}
            title={`${i.label} (${i.key})`}
            data-dock-key={i.key}
            class:list={["it", i.active && "on"]}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i.page]} />
            <span>{i.label}</span>
          </a>
        </li>
      ))}
      <li>
        <a href={switchHref} hreflang={other} lang={other} title={t(lang, "nav.switch")} class="it lang">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.globe} />
          <span>{other.toUpperCase()}</span>
        </a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .island {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 5px;
    border-radius: 999px;
    background: #0d0e14;
    border: 1px solid var(--color-line-strong);
    box-shadow:
      0 18px 40px -12px #000,
      inset 0 1px 0 rgb(255 255 255 / 0.06);
    font-family: var(--font-mono);
  }
  .brand {
    display: grid;
    place-items: center;
    flex: none;
    border-radius: 999px;
    cursor: pointer;
    transition: transform 0.3s;
  }
  .brand img {
    width: 34px;
    height: 34px;
    border-radius: 999px;
  }
  .island:hover .brand,
  .island.open .brand {
    transform: rotate(-12deg) scale(1.05);
  }

  .it {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    border-radius: 999px;
    color: var(--color-fg);
    font-size: 12.5px;
    white-space: nowrap;
    overflow: hidden;
    /* collapsed: hidden but still in the accessibility tree and tab order */
    max-width: 0;
    opacity: 0;
    padding: 0;
    transition:
      max-width 0.45s cubic-bezier(0.2, 0.9, 0.25, 1.1),
      opacity 0.3s,
      padding 0.45s cubic-bezier(0.2, 0.9, 0.25, 1.1),
      background-color 0.2s,
      color 0.2s;
  }
  .it svg {
    width: 16px;
    height: 16px;
    flex: none;
  }
  .it.on {
    max-width: 180px;
    opacity: 1;
    padding: 0 14px;
    color: #fff;
    font-weight: 700;
    background: linear-gradient(135deg, rgb(187 154 247 / 0.28), rgb(122 162 247 / 0.28));
  }

  /* expanded: hover, keyboard focus inside, a tap (.open), or a page with no section of its own */
  .island:hover .it,
  .island:focus-within .it,
  .island.open .it,
  .island.no-active .it {
    max-width: 180px;
    opacity: 1;
    padding: 0 12px;
  }
  .island:hover .it:not(.on):hover,
  .island.open .it:not(.on):hover {
    background: rgb(255 255 255 / 0.07);
    color: #fff;
  }
  .it.lang {
    color: var(--color-cyan);
  }

  /* phones: icon over a small label so the expanded island fits a 360 px screen */
  @media (max-width: 639px) {
    .it {
      flex-direction: column;
      justify-content: center;
      gap: 1px;
      height: 42px;
      font-size: 10px;
    }
    .it.on,
    .island:hover .it,
    .island:focus-within .it,
    .island.open .it,
    .island.no-active .it {
      padding: 0 9px;
    }
    .brand img {
      width: 38px;
      height: 38px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .it,
    .brand {
      transition: none;
    }
  }
</style>

<script>
  const islands = () => document.querySelectorAll<HTMLElement>("[data-island]");
  const setOpen = (island: HTMLElement, open: boolean) => {
    island.classList.toggle("open", open);
    island.querySelector("[data-island-toggle]")?.setAttribute("aria-expanded", String(open));
  };

  document.addEventListener("click", (e) => {
    const target = e.target as Element;
    const island = target.closest<HTMLElement>("[data-island]");
    if (!island) {
      islands().forEach((i) => setOpen(i, false));
      return;
    }
    if (target.closest("[data-island-toggle]")) {
      setOpen(island, !island.classList.contains("open"));
      return;
    }
    // On touch screens the first tap on the current section opens the island instead of reloading.
    const link = target.closest<HTMLAnchorElement>("a.it.on");
    if (link && !island.classList.contains("open") && matchMedia("(hover: none)").matches) {
      e.preventDefault();
      setOpen(island, true);
    }
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") islands().forEach((i) => setOpen(i, false));
  });
  document.addEventListener("astro:after-swap", () => islands().forEach((i) => setOpen(i, false)));

  // Keys 1–4 jump to the sections (ignored while typing or with modifiers).
  document.addEventListener("keydown", (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey || e.repeat) return;
    if ((e.target as HTMLElement).closest("input, textarea, select, [contenteditable='true']")) return;
    const link = document.querySelector<HTMLAnchorElement>(`[data-dock-key="${e.key}"]`);
    if (link) {
      e.preventDefault();
      link.click();
    }
  });
</script>
