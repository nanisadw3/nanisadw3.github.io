---
// Bottom status bar styled after Linux bars (waybar / i3): numbered "workspaces" for the main
// pages, language switch and a clock. Keys 1–4 jump between workspaces. Solid background (no
// backdrop blur) so scrolling stays smooth on phones.
import type { Lang } from "../i18n/ui.ts";
import { localizePath, otherLang, t } from "../i18n/utils.ts";

interface Props {
  lang: Lang;
  /** Same page in the other language, or null to fall back to its home page. */
  altHref: string | null;
}

const { lang, altHref } = Astro.props;
const other = otherLang(lang);
const switchHref = altHref ?? localizePath(other, "home");
const path = Astro.url.pathname.replace(/\/?$/, "/");

// Lucide icons (ISC license), stroke-based so they inherit currentColor.
const icons = {
  home: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  projects: '<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>',
  blog: '<path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/>',
  terminal: '<polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/>',
};

const items = (["home", "projects", "blog", "terminal"] as const).map((page, i) => {
  const href = localizePath(lang, page);
  const active = page === "home" ? path === href : path.startsWith(href);
  return { page, href, active, key: String(i + 1), label: t(lang, `nav.${page}`) };
});
---

<nav
  aria-label={lang === "es" ? "Secciones" : "Sections"}
  class="fixed bottom-3 left-1/2 z-40 -translate-x-1/2 sm:bottom-4"
  transition:name="dock"
  transition:animate="none"
>
  <div class="relative flex items-center gap-1 rounded-xl border border-line-strong bg-bg-dark p-1 font-mono shadow-[0_14px_40px_-10px_#000]">
    <!-- brand accent along the top edge -->
    <span class="pointer-events-none absolute inset-x-4 -top-px h-px bg-gradient-to-r from-mag via-blue to-cyan" aria-hidden="true"></span>

    <img src="/favicon.svg" alt="" width="28" height="28" class="mx-1 hidden size-7 rounded-md sm:block" />

    <ul class="flex items-center gap-0.5">
      {items.map((i) => (
        <li>
          <a
            href={i.href}
            aria-current={i.active ? "page" : undefined}
            aria-keyshortcuts={i.key}
            title={`${i.label} (${i.key})`}
            data-dock-key={i.key}
            class:list={[
              "flex flex-col items-center gap-0.5 rounded-lg px-2.5 py-1.5 text-[11px] transition-colors sm:flex-row sm:gap-2 sm:px-3 sm:py-2 sm:text-[12.5px]",
              i.active ? "bg-blue font-bold text-bg-dark" : "text-fg-2 hover:bg-line hover:text-fg",
            ]}
          >
            <span class:list={["hidden text-[11px] sm:inline", i.active ? "text-bg-dark/60" : "text-dim"]} aria-hidden="true">{i.key}</span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-[18px] sm:size-4"
              aria-hidden="true"
              set:html={icons[i.page]}
            />
            <span>{i.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <span class="mx-0.5 h-7 w-px bg-line-strong sm:mx-1" aria-hidden="true"></span>

    <a
      href={switchHref}
      hreflang={other}
      lang={other}
      title={t(lang, "nav.switch")}
      class="flex flex-col items-center gap-0.5 rounded-lg px-2 py-1.5 text-[11px] text-fg-2 transition-colors hover:bg-line hover:text-fg sm:flex-row sm:gap-1 sm:px-2.5 sm:py-2 sm:text-[12.5px]"
    >
      <span class:list={[lang === "es" ? "font-bold text-cyan" : "text-dim"]}>ES</span><span class="hidden text-dim sm:inline">|</span><span class:list={[lang === "en" ? "font-bold text-cyan" : "text-dim"]}>EN</span>
    </a>

    <time data-dock-clock class="hidden pr-2 pl-1 text-[12.5px] whitespace-nowrap text-dim md:block" aria-hidden="true"></time>
  </div>
</nav>

<script>
  // Keys 1–4 jump to the dock's workspaces (ignored while typing or with modifiers).
  document.addEventListener("keydown", (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey || e.repeat) return;
    const el = e.target as HTMLElement;
    if (el.closest("input, textarea, select, [contenteditable='true']")) return;
    const link = document.querySelector<HTMLAnchorElement>(`[data-dock-key="${e.key}"]`);
    if (link) {
      e.preventDefault();
      link.click();
    }
  });

  // Waybar-style clock, refreshed every 15 s.
  const tick = () => {
    const el = document.querySelector("[data-dock-clock]");
    if (el) el.textContent = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", hour12: false });
  };
  tick();
  setInterval(tick, 15_000);
  document.addEventListener("astro:page-load", tick);
</script>
