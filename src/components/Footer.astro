---
import type { Lang } from "../i18n/ui.ts";
import { t } from "../i18n/utils.ts";
import { contact } from "../data/profile.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-line pb-24">
  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-6 font-mono text-xs text-dim sm:flex-row sm:items-center sm:justify-between sm:px-7">
    <p>© {year} Iñaki Sobera</p>
    <p class="flex flex-wrap gap-x-4 gap-y-1">
      <a href={`mailto:${contact.email}`} class="hover:text-fg">{contact.email}</a>
      <a href={contact.siteSource} class="hover:text-fg">{t(lang, "footer.made")}</a>
    </p>
  </div>
</footer>
