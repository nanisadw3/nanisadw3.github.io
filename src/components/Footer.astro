---
import type { Lang } from "../i18n/ui.ts";
import { t } from "../i18n/utils.ts";
import { contact } from "../data/profile.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-8 text-sm text-faint sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>© {year} {t(lang, "footer.rights")}</p>
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      <li><a href={`mailto:${contact.email}`} class="hover:text-fg transition-colors">{contact.email}</a></li>
      <li><a href={contact.github} class="hover:text-fg transition-colors">GitHub</a></li>
      <li><a href={contact.linkedin} class="hover:text-fg transition-colors">LinkedIn</a></li>
      <li><a href={contact.siteSource} class="hover:text-fg transition-colors">{t(lang, "footer.source")}</a></li>
    </ul>
  </div>
</footer>
