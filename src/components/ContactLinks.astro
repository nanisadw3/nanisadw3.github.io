---
import type { Lang } from "../i18n/ui.ts";
import { t } from "../i18n/utils.ts";
import { contact } from "../data/profile.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const secondary = [
  { href: contact.linkedin, label: "LinkedIn" },
  { href: contact.github, label: "GitHub" },
  { href: contact.cv, label: t(lang, "hero.ctaCv") },
];
---

<div class="rounded-xl border border-line bg-surface/40 p-6 sm:p-10">
  <h3 class="text-2xl font-semibold tracking-tight sm:text-3xl">{t(lang, "contact.title")}</h3>
  <p class="mt-3 max-w-xl leading-relaxed text-muted">{t(lang, "contact.text")}</p>
  <div class="mt-6 flex flex-wrap gap-3">
    <a href={`mailto:${contact.email}`} class="rounded-lg bg-fg px-4 py-2.5 font-mono text-sm font-semibold text-bg transition-opacity hover:opacity-90">
      {contact.email}
    </a>
    {secondary.map((l) => (
      <a href={l.href} class="rounded-lg border border-line px-4 py-2.5 text-sm text-fg transition-colors hover:border-faint">{l.label}</a>
    ))}
  </div>
</div>
