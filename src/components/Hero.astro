---
import Metrics from "./Metrics.astro";
import type { Lang } from "../i18n/ui.ts";
import { localizePath, t } from "../i18n/utils.ts";
import { contact, profile } from "../data/profile.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const p = profile[lang];
---

<section class="mx-auto max-w-5xl px-4 pt-16 pb-6 sm:px-6 sm:pt-24">
  <p class="mb-5 font-mono text-xs uppercase tracking-[0.15em] text-accent">{p.role}</p>
  <h1 class="max-w-3xl text-4xl font-semibold leading-[1.05] tracking-tight text-balance sm:text-6xl">
    {p.headline.lead}
    <span class="text-muted">{p.headline.muted}</span>
  </h1>
  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted text-pretty">{p.intro}</p>

  <div class="mt-8 flex flex-wrap gap-3">
    <a href={localizePath(lang, "projects")} class="rounded-lg bg-fg px-4 py-2.5 text-sm font-semibold text-bg transition-opacity hover:opacity-90">
      {t(lang, "hero.ctaProjects")}
    </a>
    <a href={contact.cv} class="rounded-lg border border-line px-4 py-2.5 text-sm text-fg transition-colors hover:border-faint">
      {t(lang, "hero.ctaCv")}
    </a>
    <a href={`mailto:${contact.email}`} class="rounded-lg border border-line px-4 py-2.5 font-mono text-sm text-muted transition-colors hover:border-faint hover:text-fg">
      {contact.email}
    </a>
  </div>

  <div class="mt-12">
    <Metrics items={p.metrics} />
  </div>
</section>
