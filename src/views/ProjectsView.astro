---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";
import ProjectLinks from "../components/ProjectLinks.astro";
import RepoMeta from "../components/RepoMeta.astro";
import LiveSiteBadge from "../components/LiveSiteBadge.astro";
import type { Lang } from "../i18n/ui.ts";
import { localizePath, otherLang, t } from "../i18n/utils.ts";
import { evidenceText } from "../data/live.ts";
import { getProjects, slugOf } from "../content/queries.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const projects = await getProjects(lang);
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
---

<BaseLayout
  lang={lang}
  title={`${t(lang, "projects.title")} — Iñaki Sobera`}
  description={t(lang, "meta.projectsDescription")}
  altHref={localizePath(otherLang(lang), "projects")}
>
  <div class="mx-auto max-w-6xl px-5 pt-14 pb-16 sm:px-7">
    <SectionHead as="h1" title={t(lang, "projects.title")} />
    <p class="-mt-2 max-w-2xl">{t(lang, "projects.intro")}</p>

    <div class="mt-10 grid gap-6">
      {featured.map((p, i) => {
        const href = localizePath(lang, "project", slugOf(p));
        return (
          <article class="group reveal relative grid overflow-hidden rounded-xl border border-line bg-panel transition-colors hover:border-blue/70 md:grid-cols-[1.05fr_1fr]">
            <div class:list={["relative overflow-hidden border-line bg-bg-dark max-md:border-b md:border-r", i % 2 === 1 && "md:order-2 md:border-r-0 md:border-l"]}>
              {p.data.liveSite && <LiveSiteBadge lang={lang} url={p.data.liveSite.url} label={p.data.liveSite.label} />}
              <Image src={p.data.image} alt={p.data.imageAlt} widths={[400, 560, 900]} sizes="(min-width: 1152px) 560px, (min-width: 768px) 48vw, 100vw" loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : "auto"} class="aspect-[16/10] size-full object-cover object-left-top transition duration-500 group-hover:scale-[1.02]" />
            </div>
            <div class="flex flex-col p-6">
              <p class="font-mono text-[11.5px] text-orange">{p.data.live ? evidenceText(lang, p.data.live) : p.data.metric}</p>
              <!-- The title link stretches over the whole card; the buttons below sit above it (z-10). -->
              <h2 class="mt-1 font-mono text-2xl font-bold text-fg"><a href={href} class="after:absolute after:inset-0 group-hover:text-cyan">{p.data.title}</a></h2>
              <p class="mt-2 flex-1 leading-relaxed">{p.data.summary}</p>
              {p.data.liveSite && (
                <div class="relative z-10 mt-4 flex flex-col gap-3 rounded-lg border border-green/40 bg-green/[0.07] p-3.5 sm:flex-row sm:items-center sm:justify-between">
                  <p>
                    <span class="block font-mono text-[12px] text-green">● {t(lang, "projects.liveSite")}</span>
                    <span class="block font-mono text-[12px] whitespace-nowrap text-green/80">{p.data.liveSite.label}</span>
                    <span class="mt-1 block text-[13px] leading-snug text-fg-2">{p.data.liveSite.text}</span>
                  </p>
                  <LiveSiteBadge lang={lang} url={p.data.liveSite.url} label={p.data.liveSite.label} inline />
                </div>
              )}
              <div class="relative z-10 mt-4 grid gap-3">
                <RepoMeta lang={lang} repo={p.data.repo} />
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <ProjectLinks lang={lang} links={p.data.links} />
                  <a href={href} class="font-mono text-[13px] font-bold text-blue hover:underline">{t(lang, "projects.caseStudy")} →</a>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <details class="group mt-10 border-t border-line pt-2">
      <summary class="cursor-pointer list-none py-4 font-mono text-[13px] text-blue [&::-webkit-details-marker]:hidden">
        <span class="group-open:hidden">+ {t(lang, "projects.more")} ({rest.length})</span>
        <span class="hidden group-open:inline">− {t(lang, "projects.less")}</span>
      </summary>
      <div class="grid gap-4 pt-2 sm:grid-cols-2 lg:grid-cols-3">
        {rest.map((p) => {
          // Primary destination of the card: its case study, or else its code.
          const href = p.data.caseStudy ? localizePath(lang, "project", slugOf(p)) : (p.data.links.github ?? p.data.links.pr);
          const external = !p.data.caseStudy;
          const liveUrl = p.data.liveSite?.url ?? p.data.links.demo;
          return (
            <article class="group relative flex flex-col overflow-hidden rounded-xl border border-line bg-panel transition-colors hover:border-blue/60">
              <div class="relative overflow-hidden border-b border-line bg-bg-dark">
                <Image src={p.data.image} alt={p.data.imageAlt} widths={[400, 640]} sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw" class="aspect-[16/10] w-full object-cover object-left-top transition duration-500 group-hover:scale-[1.03]" />
                {liveUrl && <LiveSiteBadge lang={lang} url={liveUrl} label={new URL(liveUrl).host} size="sm" />}
              </div>
              <div class="flex flex-1 flex-col p-4">
                <h3 class="font-mono font-bold text-cyan">
                  <a href={href} {...(external ? { target: "_blank", rel: "noopener" } : {})} class="after:absolute after:inset-0 group-hover:underline">{p.data.title}</a>
                </h3>
                {p.data.role && <p class="mt-1"><span class="rounded-full border border-mag/40 px-2 py-0.5 font-mono text-[11px] text-mag">{p.data.role}</span></p>}
                <p class="mt-1.5 flex-1 text-[13.5px] leading-relaxed">{p.data.summary}</p>
                <div class="mt-3 grid gap-2.5">
                  <RepoMeta lang={lang} repo={p.data.repo} />
                  {p.data.caseStudy ? (
                    <p class="font-mono text-xs text-blue">{t(lang, "projects.caseStudy")} →</p>
                  ) : (
                    <ProjectLinks lang={lang} links={p.data.links} hide={["demo"]} />
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </details>
  </div>
</BaseLayout>
