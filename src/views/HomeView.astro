<script>
  // Hide the "scroll for more" hint as soon as the visitor starts scrolling.
  const syncHint = () => {
    const hint = document.querySelector<HTMLElement>("[data-scroll-hint]");
    if (hint) hint.style.opacity = window.scrollY > 40 ? "0" : "1";
  };
  window.addEventListener("scroll", syncHint, { passive: true });
  document.addEventListener("astro:page-load", syncHint);
</script>
