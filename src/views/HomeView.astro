---
import BaseLayout from "../layouts/BaseLayout.astro";
import Neofetch from "../components/Neofetch.astro";
import SectionHead from "../components/SectionHead.astro";
import ContribGraph from "../components/ContribGraph.astro";
import LangBar from "../components/LangBar.astro";
import PostItem from "../components/PostItem.astro";
import KernelCard from "../components/KernelCard.astro";
import type { Lang } from "../i18n/ui.ts";
import { localizePath, otherLang, t } from "../i18n/utils.ts";
import { contact, kernel, profile, whatsappUrl } from "../data/profile.ts";
import { compact, evidenceText, formatNumber, github, lastWeeks, pypi, weeklyTotals, xerebro } from "../data/live.ts";
import { getPosts } from "../content/queries.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const p = profile[lang];
const posts = (await getPosts(lang)).slice(0, 1);
const spark = weeklyTotals(github.calendar as [string, number][]).slice(-26);
const sparkMax = Math.max(...spark, 1);
const topLang = github.languages[0];
const other = lang === "es" ? "otros" : "other";

// Proof row under the hero: real numbers that the daily rebuild keeps current.
const stats = [
  { value: String(kernel.patches.length), label: t(lang, "hero.stat.kernel"), href: localizePath(lang, "post", "dos-parches-mas-kernel"), icon: "tux" },
  { value: compact(pypi.lastMonth), label: t(lang, "hero.stat.pypi"), href: localizePath(lang, "project", "mcp-banxico"), icon: "package" },
  { value: formatNumber(lang, xerebro.daysWithReport), label: t(lang, "hero.stat.rag"), href: localizePath(lang, "project", "xerebro"), icon: "database" },
  { value: String(github.externalPrs.length + 1), label: t(lang, "gh.prs"), href: localizePath(lang, "github"), icon: "merge" },
] as const;
// Faint code behind the hero: real snippets from mcp-banxico, banxico-datos and the kernel workflow.
const ghost = [
  `@server.tool()
async def tipo_cambio_usd(
    tipo: str = "FIX",
    fecha_inicio: str | None = None,
    fecha_fin: str | None = None,
) -> str:
    """Tipo de cambio oficial USD/MXN."""
    key = "TIPO_CAMBIO_LIQUIDACION" if tipo.upper() == "LIQUIDACION" else "TIPO_CAMBIO_FIX"
    serie_info = SERIES[key]
    data = await client.get_series_data(
        serie_info["id"], fecha_inicio, fecha_fin
    )
    return json.dumps({
        "indicador": serie_info["nombre"],
        "serie_id": serie_info["id"],
    })

@server.tool()
async def inflacion_mexico(tipo: str = "anual") -> str:

@server.tool()
async def valor_udis(fecha: str | None = None) -> str:

@server.tool()
async def reservas_internacionales() -> str:`,
  `def pedir(id_serie, desde, hasta, token):
    url = f"{API}/{id_serie}/datos/{desde}/{hasta}"
    req = urllib.request.Request(
        url, headers={"Bmx-Token": token}
    )
    with urllib.request.urlopen(req, timeout=60) as resp:
        cuerpo = json.load(resp)
    datos = cuerpo["bmx"]["series"][0].get("datos") or []
    filas = []
    for d in datos:
        valor = d["dato"].replace(",", "")
        if valor in ("N/E", ""):
            continue
        filas.append((d["fecha"], float(valor)))
    return filas

for s in SERIES:
    puntos = pedir(s["id"], desde, hoy, token)
    escribir_csv(DIR_DATOS / f"{s['clave']}.csv", puntos)`,
  `$ git fetch staging staging-testing
$ git rebase staging/staging-testing
$ make W=1 drivers/staging/rtl8723bs/
$ ./scripts/checkpatch.pl --strict 000*.patch
total: 0 errors, 0 warnings, 0 checks
$ git format-patch -2 --cover-letter
$ git send-email --to=gregkh@linuxfoundation.org \\
    --cc=linux-staging@lists.linux.dev 000*.patch

$ uv run pytest -q
$ uv build && uv publish

$ curl -s https://banxico-mcp.duckdns.org/mcp
$ systemctl --user status banxico-sincronizar
$ git log --oneline --author="Sobera"`,
];

const statIcons = {
  package: '<path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><path d="m3.3 7 8.7 5 8.7-5"/>',
  database: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/>',
  merge: '<circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M6 21V9a9 9 0 0 0 9 9"/>',
};

const btn = "inline-flex items-center gap-2 rounded-md border border-line px-4 py-2 font-mono text-[13px] text-fg transition-colors hover:border-blue";
const btnPrimary = "inline-flex items-center gap-2 rounded-md border border-blue bg-blue px-4 py-2 font-mono text-[13px] font-bold text-bg-dark transition-opacity hover:opacity-90";

const siteUrl = new URL(localizePath(lang, "home"), Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://inakisobera.me/#person",
      name: `${p.name.first} ${p.name.last}`,
      alternateName: "Iñaki Sobera",
      jobTitle: lang === "es" ? "Ingeniero de Inteligencia Artificial" : "AI Engineer",
      description: t(lang, "meta.homeDescription"),
      url: siteUrl,
      image: new URL("/cv/foto.jpg", Astro.site).href,
      email: `mailto:${contact.email}`,
      address: { "@type": "PostalAddress", addressRegion: "Estado de México", addressCountry: "MX" },
      worksFor: { "@type": "Organization", name: "PEMEX" },
      alumniOf: { "@type": "CollegeOrUniversity", name: "UNITEC" },
      sameAs: [contact.github, contact.linkedin, contact.x, "https://pypi.org/project/mcp-banxico/"],
      knowsAbout: [
        "Artificial Intelligence",
        "Retrieval-Augmented Generation",
        "Model Context Protocol",
        "AI agents",
        "Large Language Models",
        "Python",
        "Linux kernel",
        "Qdrant",
        "Docker",
      ],
      knowsLanguage: ["es", "en"],
    },
    {
      "@type": "WebSite",
      "@id": "https://inakisobera.me/#website",
      url: "https://inakisobera.me/",
      name: "Iñaki Sobera",
      inLanguage: ["es-MX", "en-US"],
      author: { "@id": "https://inakisobera.me/#person" },
    },
  ],
};
---

<BaseLayout
  lang={lang}
  title={t(lang, "meta.homeTitle")}
  description={t(lang, "meta.homeDescription")}
  altHref={localizePath(otherLang(lang), "home")}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="relative isolate flex min-h-dvh items-center overflow-hidden pt-10 pb-[150px]">
    <div class="hero-bg" aria-hidden="true" data-nosnippet>
      <i class="glow glow-a"></i><i class="glow glow-b"></i>
      {ghost.map((code, i) => (
        <div class={`ghost ghost-${i + 1}`}><pre>{code}</pre><pre>{code}</pre></div>
      ))}
    </div>
    <div class="mx-auto grid w-full max-w-6xl items-center gap-x-12 gap-y-10 px-5 sm:px-7 lg:grid-cols-[0.95fr_1.05fr]">
      <div>
        <h1 class="font-mono text-4xl leading-[1.05] font-extrabold tracking-tight text-fg sm:text-[46px]">
          {p.name.first}<br /><span class="grad-text">{p.name.last}</span>
        </h1>
        <p class="mt-4 text-lg font-medium text-fg">{p.role}</p>
        <p class="mt-2.5 max-w-[470px] text-[15.5px] leading-relaxed">{p.summary}</p>
        <p class="mt-5 inline-flex items-center gap-2.5 font-mono text-[12.5px] text-green">
          <span class="size-[7px] rounded-full bg-green shadow-[0_0_8px_var(--color-green)]"></span>{t(lang, "hero.open")}
        </p>
        <div class="mt-6 flex flex-wrap gap-2.5">
          <a href={contact.cv} class={btnPrimary}>{t(lang, "hero.cv")}</a>
          <a href={`mailto:${contact.email}`} class={btn}>{contact.email}</a>
          <a href={contact.linkedin} class={btn}>LinkedIn</a>
        </div>

        <!-- Subtle GitHub line -->
        <a
          href={localizePath(lang, "github")}
          class="group mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-line pt-5 font-mono text-[12.5px] text-dim"
        >
          <span class="inline-flex items-center gap-2 text-fg-2 group-hover:text-fg">
            <svg viewBox="0 0 16 16" class="size-3.5 fill-current" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            {contact.githubUser}
          </span>
          {topLang && <span><i class="mr-1.5 inline-block size-2 rounded-full align-[0.05em]" style={`background:${topLang.color}`}></i>{topLang.name} {Math.round(topLang.percent)}%</span>}
          <span>★ {github.stars}</span>
          <span>{github.followers} {t(lang, "hero.followers")}</span>
          <span>{github.repos} repos</span>
          <span class="inline-flex items-end gap-2">
            <span class="flex h-[18px] items-end gap-[2px]" aria-hidden="true">
              {spark.map((v) => <i class="block w-[3px] rounded-[1px] bg-green/60" style={`height:${Math.max(2, Math.round((v / sparkMax) * 18))}px`}></i>)}
            </span>
            {formatNumber(lang, github.contributions)} {t(lang, "hero.contrib")}
          </span>
        </a>
      </div>

      <Neofetch lang={lang} />

      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:col-span-2">
        {stats.map((st) => (
          <li>
            <a href={st.href} class="stat group flex h-full flex-col gap-2 rounded-xl border border-line p-4 transition hover:-translate-y-0.5 hover:border-blue/60">
              <span class="flex items-center justify-between">
                <span class="font-mono text-[28px] leading-none font-extrabold text-fg">{st.value}</span>
                {st.icon === "tux"
                  ? <img src="/images/tux.svg" alt="" width="26" height="26" class="size-6.5" loading="lazy" />
                  : <svg viewBox="0 0 24 24" class="size-6 text-blue" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={statIcons[st.icon]} />}
              </span>
              <span class="text-[13px] leading-snug text-fg-2 group-hover:text-fg">{st.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <a
      href="#lo-que-hago"
      data-scroll-hint
      class="absolute bottom-[92px] left-1/2 flex -translate-x-1/2 flex-col items-center gap-1 font-mono text-[12px] text-dim transition-opacity duration-500 hover:text-fg sm:bottom-[104px]"
    >
      {t(lang, "hero.scroll")}
      <svg viewBox="0 0 24 24" class="size-5 animate-bounce motion-reduce:animate-none" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </a>
  </section>

  <!-- What I do in AI -->
  <section id="lo-que-hago" class="scroll-mt-4 border-t border-line py-16">
    <div class="reveal mx-auto max-w-6xl px-5 sm:px-7">
      <SectionHead n="01" title={t(lang, "home.ai")} />
      <div class="grid gap-3 md:grid-cols-3">
        {p.specialties.map((s) => (
          <a
            href={localizePath(lang, "project", s.project.slug)}
            class="group flex flex-col rounded-xl border border-line bg-panel p-5 transition hover:-translate-y-0.5 hover:border-blue/70 hover:bg-panel/80"
          >
            <p class="font-mono text-xs text-blue">{s.path}</p>
            <h3 class="mt-1 text-base font-semibold text-fg">{s.title}</h3>
            <p class="mt-1.5 flex-1 text-[13.5px] leading-relaxed">{s.text}</p>
            <p class="mt-4 flex items-end justify-between gap-3 border-t border-dashed border-line pt-3 font-mono text-[12.5px]">
              <span>
                <span class="text-green">→</span> <span class="font-bold text-cyan group-hover:underline">{s.project.name}</span>
                <span class="mt-0.5 block text-[11.5px] text-orange">{evidenceText(lang, s.evidence)}</span>
              </span>
              <span class="text-[11.5px] text-dim transition-colors group-hover:text-blue">{t(lang, "home.caseStudy")} →</span>
            </p>
          </a>
        ))}
      </div>
      <p class="mt-4 font-mono text-[12px] text-dim"><span class="text-blue">{t(lang, "home.also")}</span> · {p.also}</p>
    </div>
  </section>

  <!-- Experience -->
  <section class="border-t border-line py-20">
    <div class="reveal mx-auto max-w-6xl px-5 sm:px-7">
      <SectionHead n="02" title={t(lang, "home.experience")} />
      {p.experience.map((e) => (
        <article class="grid gap-6 rounded-2xl border border-line bg-panel p-6 sm:p-8 lg:grid-cols-[260px_1fr] lg:gap-10">
          <div>
            <p class="inline-flex items-center gap-2 rounded-full border border-green/40 bg-green/10 px-2.5 py-0.5 font-mono text-[11px] text-green">
              <span class="size-1.5 rounded-full bg-green"></span>{t(lang, "home.current")}
            </p>
            <p class="mt-4 font-mono text-2xl font-extrabold text-fg">{e.company}</p>
            <p class="mt-1 font-mono text-sm text-dim">{e.period}</p>
            <div class="mt-5 flex flex-wrap gap-1.5">
              {e.tags.map((tag) => <span class="rounded-md border border-line px-2 py-0.5 font-mono text-[11px] text-fg-2">{tag}</span>)}
            </div>
          </div>
          <div>
            <h3 class="text-xl font-semibold text-fg sm:text-2xl">{e.role}</h3>
            <p class="mt-2 text-[15px] leading-relaxed">{e.text}</p>
            <ul class="mt-6 grid gap-4">
              {e.highlights.map((h) => (
                <li class="border-l-2 border-blue/50 pl-4">
                  <p class="font-semibold text-fg">{h.title}</p>
                  <p class="mt-1 text-[14.5px] leading-relaxed">{h.text}</p>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Education + certifications -->
  <section class="border-t border-line py-20">
    <div class="reveal mx-auto max-w-6xl px-5 sm:px-7">
      <SectionHead n="03" title={t(lang, "home.education")} />
      <div class="grid gap-4 md:grid-cols-2">
        {p.education.map((e) => (
          <article class="rounded-2xl border border-line bg-panel p-6">
            <p class="font-mono text-sm text-blue">{e.period}</p>
            <h3 class="mt-2 text-lg font-semibold text-fg sm:text-xl">{e.title}</h3>
            <p class="mt-0.5 font-mono text-[13px] text-fg-2">{e.place}</p>
            {e.note && <p class="mt-3 text-[14.5px] leading-relaxed">{e.note}</p>}
          </article>
        ))}
      </div>

      <h3 class="mt-10 mb-4 font-mono text-base font-bold text-fg">{t(lang, "home.certs")}</h3>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {p.certifications.map((c) => (
          <article class="flex flex-col rounded-xl border border-line bg-bg-dark p-4">
            <p class="font-semibold text-fg">{c.title}</p>
            <p class="mt-0.5 flex-1 font-mono text-[12px] text-dim">{c.issuer} · {c.date}</p>
            {(c.verifyUrl || c.file) && (
              <p class="mt-3 flex flex-wrap gap-2 font-mono text-[11.5px]">
                {c.verifyUrl && <a href={c.verifyUrl} class="rounded-md border border-line px-2 py-0.5 text-fg-2 transition-colors hover:border-blue hover:text-fg">{t(lang, "home.verify")} ↗</a>}
                {c.file && <a href={c.file} class="rounded-md border border-line px-2 py-0.5 text-fg-2 transition-colors hover:border-blue hover:text-fg">{t(lang, "home.pdf")} ↗</a>}
              </p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- GitHub summary -->
  <section class="border-t border-line py-16">
    <div class="reveal mx-auto max-w-6xl px-5 sm:px-7">
      <SectionHead n="04" title={t(lang, "home.github")} href={localizePath(lang, "github")} hrefLabel={t(lang, "home.githubMore")} />
      <div class="mb-4"><KernelCard lang={lang} /></div>
      <div class="grid items-center gap-7 rounded-xl border border-line bg-bg-dark p-5 lg:grid-cols-[auto_1fr]">
        <div class="overflow-x-auto"><ContribGraph lang={lang} days={lastWeeks(github.calendar as [string, number][], 26)} cell={9} /></div>
        <div class="grid grid-cols-2 gap-x-6 gap-y-3 font-mono">
          <div><p class="text-base font-bold text-fg">{formatNumber(lang, github.contributions)}</p><p class="text-[11px] text-dim">{t(lang, "gh.contributions")}</p></div>
          <div><p class="text-base font-bold text-fg">{github.externalPrs.length + 1}</p><p class="text-[11px] text-dim">{t(lang, "gh.prs")}</p></div>
          <div><p class="text-base font-bold text-fg">{github.repos} · ★ {github.stars}</p><p class="text-[11px] text-dim">{t(lang, "gh.repos")} · {t(lang, "gh.stars")}</p></div>
          <div><p class="text-base font-bold text-fg">{compact(github.followers)}</p><p class="text-[11px] text-dim">{t(lang, "gh.followers")}</p></div>
          <div class="col-span-2 mt-1"><LangBar otherLabel={other} /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog -->
  {posts.length > 0 && (
    <section class="border-t border-line py-16">
      <div class="reveal mx-auto max-w-6xl px-5 sm:px-7">
        <SectionHead n="05" title={t(lang, "home.blog")} href={localizePath(lang, "blog")} hrefLabel={t(lang, "home.blogMore")} />
        {posts.map((post) => <PostItem lang={lang} post={post} />)}
      </div>
    </section>
  )}

  <!-- Contact -->
  <section class="border-t border-line py-16">
    <div class="reveal mx-auto max-w-6xl px-5 sm:px-7">
      <div class="flex flex-col gap-5 rounded-xl border border-line bg-panel p-6 sm:p-8">
        <div>
          <h2 class="font-mono text-[22px] font-bold text-fg">{t(lang, "home.contactTitle")}</h2>
          <p class="mt-1 max-w-lg">{t(lang, "home.contactText")}</p>
        </div>
        <div class="flex flex-wrap gap-2.5">
          <a href={`mailto:${contact.email}`} class={btnPrimary}>{contact.email}</a>
          <a
            href={whatsappUrl(lang)}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-md border border-[#25d366] bg-[#25d366] px-4 py-2 font-mono text-[13px] font-bold text-bg-dark transition-opacity hover:opacity-90"
          >
            <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.05 21.8h-.01a9.8 9.8 0 0 1-5-1.37l-.36-.21-3.72.98 1-3.63-.24-.37a9.78 9.78 0 0 1-1.5-5.21c0-5.41 4.41-9.82 9.84-9.82 2.63 0 5.1 1.03 6.95 2.88a9.76 9.76 0 0 1 2.88 6.95c0 5.42-4.41 9.83-9.84 9.83zm8.37-18.2A11.76 11.76 0 0 0 12.05 0C5.5 0 .17 5.33.16 11.88c0 2.1.55 4.14 1.59 5.94L.06 24l6.33-1.66a11.88 11.88 0 0 0 5.66 1.44h.01c6.55 0 11.88-5.33 11.89-11.88 0-3.18-1.24-6.16-3.48-8.41z"/></svg>
            WhatsApp
          </a>
          <a href={contact.linkedin} class={btn}>LinkedIn</a>
          <a href={contact.github} class={btn}>GitHub</a>
          <a href={contact.cv} class={btn}>CV</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* hero backdrop: real code drifting upward, very faint, plus two slow colour glows */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .ghost {
    position: absolute;
    top: 0;
    width: 34rem;
    max-width: 90vw;
    font: 12.5px/1.75 var(--font-mono);
    color: rgb(169 177 214 / 0.05);
    filter: blur(0.7px);
    mask-image: linear-gradient(transparent, #000 18%, #000 78%, transparent);
    animation: rise linear infinite;
  }
  .ghost pre {
    margin: 0;
    padding-bottom: 3rem;
    white-space: pre;
    font: inherit;
  }
  .ghost-1 { left: 2%; animation-duration: 95s; }
  .ghost-2 { left: 36%; animation-duration: 120s; animation-delay: -40s; color: rgb(187 154 247 / 0.05); }
  .ghost-3 { left: 68%; animation-duration: 105s; animation-delay: -20s; color: rgb(125 207 255 / 0.05); }
  @keyframes rise {
