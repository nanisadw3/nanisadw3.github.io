---
import { Image } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectLinks from "../components/ProjectLinks.astro";
import RepoMeta from "../components/RepoMeta.astro";
import LiveBox from "../components/LiveBox.astro";
import LiveSiteBadge from "../components/LiveSiteBadge.astro";
import type { Lang } from "../i18n/ui.ts";
import { localizePath, otherLang, t } from "../i18n/utils.ts";
import { hasTranslation, slugOf } from "../content/queries.ts";

interface Props {
  lang: Lang;
  project: CollectionEntry<"projects">;
}

const { lang, project } = Astro.props;
const { title, summary, image, imageAlt, tags, metric, links, live, repo, liveSite } = project.data;
const slug = slugOf(project);
const { Content } = await render(project);
const altHref = (await hasTranslation("projects", otherLang(lang), slug))
  ? localizePath(otherLang(lang), "project", slug)
  : null;
---

<BaseLayout lang={lang} title={`${title} — Iñaki Sobera`} description={summary} image={image} altHref={altHref} type="article">
  <article class="mx-auto max-w-5xl px-5 pt-12 pb-20 sm:px-7">
    <a href={localizePath(lang, "projects")} class="font-mono text-[13px] text-dim transition-colors hover:text-fg">← {t(lang, "projects.back")}</a>

    <header class="mt-8 max-w-3xl">
      <p class="font-mono text-xs text-blue">{tags.join(" · ")}</p>
      <h1 class="mt-2 font-mono text-3xl font-extrabold tracking-tight text-fg sm:text-4xl">{title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-pretty">{summary}</p>
      <div class="mt-5 grid gap-3">
        <RepoMeta lang={lang} repo={repo} />
        <ProjectLinks lang={lang} links={links} />
        {!live && metric && <p class="font-mono text-xs text-orange">{metric}</p>}
      </div>
    </header>

    {live && <div class="mt-8"><LiveBox lang={lang} kind={live} /></div>}

    <figure class="relative mt-8 overflow-hidden rounded-xl border border-line bg-bg-dark">
      {liveSite ? (
        <a href={liveSite.url} target="_blank" rel="noopener" class="group block">
          <Image src={image} alt={imageAlt} widths={[640, 1024, 1280]} sizes="(min-width: 1024px) 1024px, 100vw" class="w-full transition duration-500 group-hover:scale-[1.01]" loading="eager" />
        </a>
      ) : (
        <Image src={image} alt={imageAlt} widths={[640, 1024, 1280]} sizes="(min-width: 1024px) 1024px, 100vw" class="w-full" loading="eager" />
      )}
      {liveSite && <LiveSiteBadge lang={lang} url={liveSite.url} label={liveSite.label} />}
      {liveSite && (
        <figcaption>
          <a href={liveSite.url} target="_blank" rel="noopener" class="group flex items-center justify-between gap-4 border-t border-line bg-panel px-5 py-4 transition-colors hover:bg-panel/70">
            <span>
              <span class="block font-mono text-[12px] text-green">● {t(lang, "projects.liveSite")} · {liveSite.label}</span>
              <span class="mt-1 block text-sm leading-snug text-fg-2">{liveSite.text}</span>
            </span>
            <span class="shrink-0 rounded-md border border-green/40 px-3 py-1.5 font-mono text-[12.5px] text-green transition-colors group-hover:border-green">{t(lang, "projects.open")} ↗</span>
          </a>
        </figcaption>
      )}
    </figure>

    <div class="prose-site mt-12">
      <Content />
    </div>
  </article>
</BaseLayout>
