---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";
import PostItem from "../components/PostItem.astro";
import type { Lang } from "../i18n/ui.ts";
import { localizePath, otherLang, t } from "../i18n/utils.ts";
import { getPosts } from "../content/queries.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const posts = await getPosts(lang);
---

<BaseLayout
  lang={lang}
  title={`${t(lang, "blog.title")} — Iñaki Sobera`}
  description={t(lang, "meta.blogDescription")}
  altHref={localizePath(otherLang(lang), "blog")}
>
  <div class="mx-auto max-w-3xl px-5 pt-14 pb-16 sm:px-7">
    <SectionHead as="h1" title={t(lang, "blog.title")} />
    <p class="-mt-2 mb-8">{t(lang, "blog.intro")}</p>
    {posts.length > 0 ? posts.map((post) => <PostItem lang={lang} post={post} />) : (
      <p class="rounded-xl border border-dashed border-line p-6 font-mono text-sm text-dim">{t(lang, "blog.empty")}</p>
    )}
  </div>
</BaseLayout>
