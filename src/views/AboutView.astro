---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import ExperienceItem from "../components/ExperienceItem.astro";
import ContactLinks from "../components/ContactLinks.astro";
import type { Lang } from "../i18n/ui.ts";
import { localizePath, otherLang, t } from "../i18n/utils.ts";
import { profile } from "../data/profile.ts";
import portrait from "../assets/yo.png";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const p = profile[lang];
---

<BaseLayout
  lang={lang}
  title={`${t(lang, "about.title")} — Iñaki Sobera`}
  description={t(lang, "meta.aboutDescription")}
  altHref={localizePath(otherLang(lang), "about")}
>
  <header class="mx-auto grid max-w-5xl gap-10 px-4 pt-16 sm:px-6 sm:pt-20 md:grid-cols-[1fr_260px] md:items-start">
    <div>
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{t(lang, "about.title")}</h1>
      <div class="mt-6 space-y-4 text-lg leading-relaxed text-muted">
        {p.bio.map((para) => <p class="text-pretty">{para}</p>)}
      </div>
    </div>
    <Image
      src={portrait}
      alt={p.name}
      width={520}
      class="w-48 rounded-xl border border-line grayscale md:w-full"
      loading="eager"
    />
  </header>

  <Section title={t(lang, "about.experience")}>
    <div class="space-y-12">
      {p.experience.map((item) => <ExperienceItem item={item} />)}
    </div>
  </Section>

  <Section title={t(lang, "about.education")}>
    <ul class="space-y-6">
      {p.education.map((e) => (
        <li class="grid gap-1 sm:grid-cols-[200px_1fr] sm:gap-8">
          <p class="font-mono text-xs text-faint sm:pt-1">{e.period}</p>
          <div>
            <p class="font-semibold">{e.title}</p>
            <p class="text-sm text-muted">{e.institution}{e.note && <> · {e.note}</>}</p>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section title={t(lang, "about.certs")}>
    <ul class="grid gap-4 sm:grid-cols-2">
      {p.certifications.map((c) => (
        <li class="rounded-xl border border-line bg-surface/40 p-5">
          <p class="font-semibold">{c.title}</p>
          <p class="mt-1 text-sm text-muted">{c.issuer} · {c.date}</p>
          {c.code && <p class="mt-2 font-mono text-[11px] text-faint">{t(lang, "about.code")}: {c.code}</p>}
          {(c.file || c.verifyUrl) && (
            <div class="mt-4 flex flex-wrap gap-2">
              {c.file && <a href={c.file} class="rounded-md border border-line px-2.5 py-1 text-xs text-muted hover:border-faint hover:text-fg">{t(lang, "about.certificate")}</a>}
              {c.verifyUrl && <a href={c.verifyUrl} class="rounded-md border border-line px-2.5 py-1 text-xs text-muted hover:border-faint hover:text-fg">{t(lang, "about.verify")} ↗</a>}
            </div>
          )}
        </li>
      ))}
    </ul>
  </Section>

  <Section title={t(lang, "about.skills")}>
    <dl class="grid gap-6 sm:grid-cols-2">
      {p.skills.map((s) => (
        <div>
          <dt class="mb-2 text-sm font-semibold">{s.group}</dt>
          <dd class="flex flex-wrap gap-1.5">
            {s.items.map((i) => <span class="rounded-md border border-line px-2 py-0.5 font-mono text-xs text-muted">{i}</span>)}
          </dd>
        </div>
      ))}
      <div>
        <dt class="mb-2 text-sm font-semibold">{t(lang, "about.languages")}</dt>
        <dd class="text-sm text-muted">{p.languages.map((l) => `${l.name} (${l.level})`).join(" · ")}</dd>
      </div>
    </dl>
  </Section>

  <Section title={t(lang, "home.contact")}>
    <ContactLinks lang={lang} />
  </Section>
</BaseLayout>
